{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-gold-standard.local/conformance/certificate.v1.json",
  "title": "PDF Gold Standard conformance certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "file", "producer", "corpus", "ratchet_sha256", "tools", "claims", "checks",
               "readers", "tier1_unavailable", "not_checked", "verdict", "verdict_detail"],
  "properties": {
    "schema_version": {"const": "certificate/1"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "pages"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 1}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "engine_version", "pipeline_commit", "postprocess"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "pipeline_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "postprocess": {"type": "boolean"}
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["case", "category", "manifest_sha256", "cases"],
      "properties": {
        "case": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "ratchet_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["verapdf"],
      "properties": {
        "verapdf": {"type": "string", "minLength": 1},
        "pdfium": {"type": ["string", "null"]},
        "mupdf": {"type": ["string", "null"]},
        "poppler": {"type": ["string", "null"]},
        "pdfminer": {"type": ["string", "null"]},
        "pdfkit": {"type": ["string", "null"]}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["pdfua", "pdfa"],
      "properties": {
        "pdfua": {"const": "1"},
        "pdfa": {"const": "3b"}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "na"]},
          "reason": {"type": "string"}
        }
      }
    },
    "readers": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "exact", "word_f1", "order", "digit_runs", "skeleton_exact", "defects",
                     "limitations_applied", "ratcheted"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "exact": {"enum": [0, 1]},
          "word_f1": {"type": "number", "minimum": 0, "maximum": 1},
          "order": {"type": "number", "minimum": 0, "maximum": 1},
          "digit_runs": {"type": "number", "minimum": 0, "maximum": 1},
          "skeleton_exact": {"enum": [0, 1]},
          "defects": {
            "type": "object", "additionalProperties": false,
            "required": ["presentation_forms", "pua", "replacement", "bidi", "zero_width", "tatweel_excess"],
            "properties": {
              "presentation_forms": {"type": "integer", "minimum": 0},
              "pua": {"type": "integer", "minimum": 0},
              "replacement": {"type": "integer", "minimum": 0},
              "bidi": {"type": "integer", "minimum": 0},
              "zero_width": {"type": "integer", "minimum": 0},
              "tatweel_excess": {"type": "integer", "minimum": 0}
            }
          },
          "limitations_applied": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "excused", "detail", "reader_version_measured"],
              "properties": {
                "id": {"type": "string"},
                "excused": {"type": "integer", "minimum": 1},
                "detail": {"type": "string"},
                "reader_version_measured": {"type": "string"}
              }
            }
          },
          "ratcheted": {"type": "boolean"}
        }
      }
    },
    "tier1_unavailable": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reader", "reason"],
        "properties": {"reader": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "not_checked": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "conditions_total", "machine_determinable", "human_judgment", "no_specific_test", "note"],
      "properties": {
        "source": {"type": "string"},
        "conditions_total": {"type": "integer"},
        "machine_determinable": {"type": "integer"},
        "human_judgment": {"type": "integer"},
        "no_specific_test": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "verdict": {"enum": ["PASS", "FAIL"]},
    "verdict_detail": {"type": "string", "minLength": 1}
  }
}
