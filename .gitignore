# build artifacts / local outputs
out*.pdf
*.partial.pdf
/tmp-*

# working art (masters & tests stay local; embeds ship)
art/*
!art/embed-*.jpg

# macOS noise
.DS_Store

# python
__pycache__/
*.pyc

# local virtualenv
.venv/
# the conformance corpus fonts: downloaded by `python3 -m conformance.adapters.fetch_fonts`, sha256-checked,
# never committed (the owner's decision on committing them is open)
fonts/full/

# second document outputs and local backups
report.pdf
baseline*.pdf
*.raw.pdf

# Najd font files: licence is «All rights reserved» — the PDF embeds a subset, the repo does not ship the font
/najd/

# build artefacts
report-print.pdf
najd.pdf

# the Najd fixtures whose embedded subset carries the foundry's «All rights reserved» notice
# (tests/vocalised_raw.pdf deliberately stays: it is Chrome's own output with a system GeezaPro subset,
#  the only capture the vocalised regression test has — named here so the rule is not read as universal)
artifacts/*.pdf

# local secrets
.env

# generated review output (the release is the artifact, not the repo)
guide-check.pdf

# the guide build output (a release artifact, not a source)
guide-v2-ar.pdf

# local editable install
*.egg-info/

# wheel build scratch (test_packaging writes here; the wheel is the artifact)
build/
dist/

# the optional pdf.js reader installs its pinned dependency with `npm ci` (never committed)
conformance/readers/node_modules/
